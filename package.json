{
  "name": "agentic-health-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24 <25",
    "npm": "12.0.2"
  },
  "workspaces": [
    "packages/health-domain",
    "packages/health-tools",
    "services/health-agent",
    "packages/oura-client",
    "apps/cli"
  ],
  "scripts": {
    "build": "npm run build:ordered",
    "build:ordered": "npm run build --workspace=@ahp/health-domain && npm run build --workspace=@ahp/health-tools && npm run build --workspace=@ahp/health-agent && npm run build --workspace=@ahp/oura-client && npm run build --workspace=@ahp/cli",
    "typecheck": "npm run typecheck --workspaces",
    "pretest": "npm run build:ordered",
    "test": "vitest",
    "health": "node apps/cli/dist/main.js",
    "eval:synthetic": "node services/health-agent/dist/evals/run.js"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
